---
import { MessageCircle } from 'lucide-astro';
---

<a
  href="https://wa.me/5549000000000"
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50 bg-[#25D366] hover:bg-[#1EBE5D] text-white p-4 rounded-full shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300 group flex items-center justify-center"
  aria-label="Falar no WhatsApp"
>
  <span class="absolute right-full mr-4 bg-white text-brand-text text-sm py-1.5 px-3 rounded-lg shadow-md opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap pointer-events-none hidden md:block">
    Agende sua sessão
  </span>
  <MessageCircle class="w-7 h-7" />
  
  <!-- Ping effect -->
  <span class="absolute inline-flex h-full w-full rounded-full bg-[#25D366] opacity-20 animate-ping"></span>
</a>
