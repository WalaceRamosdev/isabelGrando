---
import { Sun, Shield, Sparkles, MoveUpRight, HeartHandshake, Puzzle } from 'lucide-astro';

const benefits = [
  { icon: Puzzle, text: "Autoconhecimento profundo" },
  { icon: Sun, text: "Clareza emocional para decisões" },
  { icon: Sparkles, text: "Melhora significativa da autoestima" },
  { icon: Shield, text: "Desenvolvimento de inteligência emocional" },
  { icon: HeartHandshake, text: "Construção de relações mais saudáveis" },
  { icon: MoveUpRight, text: "Redução da ansiedade e estresse" }
];
---

<section class="py-24 bg-brand-greenDark text-brand-light relative overflow-hidden">
  <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#F5F5F0 1px, transparent 1px); background-size: 32px 32px;"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <!-- Lado esquerdo: Textos e Grid de Benefícios -->
      <div>
        <div class="gsap-reveal mb-10">
          <h2 class="text-3xl md:text-4xl font-serif mb-6 text-white">
            O que você ganha ao iniciar seu processo
          </h2>
          <p class="text-lg text-brand-light/80">
            A terapia é um investimento em si mesmo que gera retornos para todas as áreas da sua vida.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {benefits.map((benefit) => (
            <div class="gsap-reveal flex items-center gap-4 p-5 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors duration-300">
              <div class="w-12 h-12 rounded-full bg-brand-light/10 flex items-center justify-center flex-shrink-0 text-brand-light">
                <benefit.icon class="w-6 h-6" />
              </div>
              <span class="font-medium text-base text-brand-light/90">{benefit.text}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Lado direito: Imagem adicional -->
      <div class="gsap-reveal delay-1 relative hidden lg:block">
        <div class="aspect-[4/5] rounded-[2rem] overflow-hidden shadow-2xl relative border border-white/10">
          <div class="absolute inset-0 bg-brand-greenDark/20 z-10 mix-blend-overlay"></div>
          <img 
            src="/profissional/isabel2.jpeg" 
            alt="Benefícios da Terapia - Isabel Grando" 
            class="object-cover w-full h-full opacity-0 transition-opacity duration-700"
            onload="this.classList.remove('opacity-0')"
            loading="lazy"
          />
        </div>
        <!-- Elemento decorativo sutil -->
        <div class="absolute -bottom-6 -left-6 w-24 h-24 bg-brand-green rounded-full blur-2xl opacity-50 -z-10"></div>
      </div>

    </div>
  </div>
</section>
