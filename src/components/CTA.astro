---
import { Heart } from 'lucide-astro';
---

<section class="py-24 bg-brand-light relative overflow-hidden">
  <!-- Círculos de fundo -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-brand-beige/50 rounded-full blur-3xl -z-10"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] bg-white rounded-full blur-2xl -z-10"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <div class="gsap-reveal flex justify-center mb-8 relative">
      <div class="w-24 h-24 md:w-28 md:h-28 rounded-full overflow-hidden shadow-xl border-4 border-white relative z-10">
        <img 
          src="/profissional/isabel1.jpeg" 
          alt="Isabel Grando - Atendimento Acolhedor" 
          class="w-full h-full object-cover object-top opacity-0 transition-opacity duration-500"
          onload="this.classList.remove('opacity-0')"
          loading="lazy"
        />
      </div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-28 h-28 bg-brand-green/20 rounded-full blur-xl -z-10"></div>
    </div>
    
    <h2 class="text-4xl md:text-5xl font-serif text-brand-greenDark mb-8 leading-tight gsap-reveal delay-1">
      Seu processo de transformação pode começar <span class="italic text-brand-green">hoje.</span>
    </h2>
    
    <p class="text-xl text-brand-textMuted mb-12 max-w-2xl mx-auto gsap-reveal delay-2">
      O primeiro passo exige coragem, mas você não precisa caminhar sozinho(a). Estou aqui para te acolher nessa jornada.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 justify-center gsap-reveal delay-3">
      <a 
        href="https://wa.me/5549000000000?text=Olá%20Isabel,%20tomei%20a%20decisão%20e%20gostaria%20de%20agendar%20minha%20consulta."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex justify-center items-center px-8 py-4 bg-brand-greenDark text-white rounded-full font-medium transition-all hover:bg-brand-green shadow-soft hover:shadow-lg transform hover:-translate-y-1 text-lg"
      >
        Agendar minha consulta
      </a>
    </div>
  </div>
</section>
