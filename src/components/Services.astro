---
import { Leaf, Heart, ArrowRight, Brain, Activity, ShieldCheck, Users } from 'lucide-astro';

const services = [
  {
    title: "Ansiedade",
    description: "Técnicas baseadas na TCC para compreender e manejar crises, pensamentos intrusivos e o ciclo da ansiedade.",
    icon: Activity
  },
  {
    title: "Autoestima",
    description: "Fortalecimento da autoimagem, redução da autocobrança e construção de uma relação mais gentil consigo mesmo.",
    icon: Heart
  },
  {
    title: "Relacionamentos",
    description: "Desenvolvimento de assertividade, estabelecimento de limites e melhora na comunicação interpessoal.",
    icon: Users
  },
  {
    title: "Desenvolvimento Emocional",
    description: "Espaço seguro para autoconhecimento, inteligência emocional e clareza para tomadas de decisão.",
    icon: Leaf
  },
  {
    title: "Terapia Cognitivo-Comportamental",
    description: "Abordagem focada no presente, prática e estruturada para identificar e modificar padrões de pensamento disfuncionais.",
    icon: Brain
  },
  {
    title: "Psicopatologia",
    description: "Avaliação e acompanhamento de transtornos psicológicos com base em evidências científicas e acolhimento.",
    icon: ShieldCheck
  }
];
---

<section id="como-ajudo" class="py-24 bg-brand-light relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 gsap-reveal">
      <span class="text-brand-green font-medium tracking-wider uppercase text-sm mb-4 block">Especialidades</span>
      <h2 class="text-3xl md:text-4xl font-serif text-brand-greenDark mb-6">
        Como posso te ajudar
      </h2>
      <p class="text-lg text-brand-textMuted">
        Através da Terapia Cognitivo-Comportamental (TCC), trabalharemos juntos para entender seus padrões e construir formas mais saudáveis de lidar com seus desafios.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="gsap-reveal group bg-white p-8 rounded-3xl shadow-sm hover:shadow-xl transition-all duration-500 border border-transparent hover:border-brand-green/20 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-brand-beige/50 rounded-bl-full -z-10 transition-transform duration-500 group-hover:scale-110"></div>
          
          <div class="w-14 h-14 bg-brand-light rounded-2xl flex items-center justify-center mb-6 text-brand-green group-hover:bg-brand-green group-hover:text-white transition-colors duration-300">
            <service.icon class="w-7 h-7" />
          </div>
          
          <h3 class="text-xl font-serif text-brand-greenDark mb-4">{service.title}</h3>
          <p class="text-brand-textMuted leading-relaxed mb-6">
            {service.description}
          </p>
          
          <a href={`https://wa.me/5549000000000?text=Olá,%20gostaria%20de%20saber%20mais%20sobre%20terapia%20para%20${service.title.toLowerCase()}.`} 
             target="_blank"
             rel="noopener noreferrer"
             class="inline-flex items-center text-sm font-medium text-brand-greenDark group-hover:text-brand-green transition-colors">
            Saber mais <ArrowRight class="w-4 h-4 ml-1 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" />
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
