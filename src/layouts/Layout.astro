---
import { defaultSEO, generateSchema } from '../utils/seo';
import '../styles/global.css';

interface Props {
	title?: string;
  description?: string;
  image?: string;
  schema?: string;
}

const { 
  title = defaultSEO.title, 
  description = defaultSEO.description, 
  image = defaultSEO.image,
  schema = generateSchema()
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || defaultSEO.url);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
		
    <!-- SEO Básico -->
		<title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={defaultSEO.type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Schema.org -->
    {schema && <script type="application/ld+json" set:html={schema} />}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	</head>
	<body class="flex flex-col min-h-screen">
		<slot />
    
    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      
      gsap.registerPlugin(ScrollTrigger);

      // Micro animações globais
      document.addEventListener("DOMContentLoaded", () => {
        const revealElements = document.querySelectorAll('.gsap-reveal');
        
        revealElements.forEach((el) => {
          gsap.fromTo(el, 
            { 
              y: 30, 
              opacity: 0,
              autoAlpha: 0 // usa visibility e opacity
            },
            {
              y: 0,
              opacity: 1,
              autoAlpha: 1,
              duration: 0.8,
              ease: "power2.out",
              scrollTrigger: {
                trigger: el,
                start: "top 85%",
                toggleActions: "play none none reverse"
              }
            }
          );
        });
      });
    </script>
	</body>
</html>
