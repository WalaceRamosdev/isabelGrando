      <!-- Sparkles 2 -->
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute top-[50%] left-[5%] sm:left-[10%] w-5 h-5 text-brand-green opacity-[0.15]"><path d="M12 3c.132 2.639 1.633 4.14 4.272 4.272-2.639.132-4.14 1.633-4.272 4.272-.132-2.639-1.633-4.14-4.272-4.272 2.639-.132 4.14-1.633 4.272-4.272Z"/><path d="M19 13.5c.088 1.759 1.089 2.76 2.848 2.848-1.759.088-2.76 1.089-2.848 2.848-.088-1.759-1.089-2.76-2.848-2.848 1.759-.088 2.76-1.089 2.848-2.848Z"/><path d="M5 6.5c.061 1.22.76 1.921 1.98 1.98-1.22.061-1.921.76-1.98 1.98-.061-1.22-.76-1.921-1.98-1.98 1.22-.061 1.921-.76 1.98-1.98Z"/></svg>
