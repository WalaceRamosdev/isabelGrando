      <!-- Footer SEO / Branding (Mantido conforme layout atual) -->
      <div class="mt-12 mb-8 text-center text-sm text-brand-greenDark">
        <p>Desenvolvido com excelência por <a href="https://www.sitesalphacode.com.br/solucoes/psicologos" target="_blank" rel="noopener" title="Criação de Sites para Psicólogos" class="hover:text-brand-green transition-colors font-medium underline underline-offset-2">Sites Alpha Code</a></p>
