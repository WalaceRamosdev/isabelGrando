    </div>

    <div class="w-full max-w-md mx-auto flex flex-col items-center relative z-10">
      
      <!-- Perfil com Otimização de LCP e CLS -->
      <div class="mb-5 relative">
        <div class="w-28 h-28 rounded-full overflow-hidden shadow-xl border-4 border-white mx-auto relative z-10 bg-brand-beige">
          <Image 
            src={profileImg} 
            alt="Isabel Grando" 
            width={112} 
            height={112} 
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover object-top"
          />
        </div>
        <!-- Brilho suave ao fundo da foto (GPU Accelerated) -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-28 h-28 bg-brand-green/20 rounded-full blur-xl -z-10 will-change-transform"></div>
      </div>

      <div class="text-center mb-10">
        <h1 class="text-2xl font-serif text-brand-greenDark font-medium mb-1 tracking-wide">Isabel Grando</h1>
        <p class="text-brand-textMuted text-xs font-medium tracking-widest uppercase">Psicóloga Clínica · CRP 12/22453</p>
      </div>

      <!-- Links -->
      <div class="w-full space-y-4">
        <a 
          href="https://wa.me/5549991069172?text=Olá%20Isabel,%20vim%20pelo%20seu%20site%20e%20gostaria%20de%20agendar%20um%20atendimento." 
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center p-4 bg-brand-greenDark text-white rounded-2xl transition-all duration-300 hover:bg-brand-green hover:-translate-y-1 shadow-lg hover:shadow-xl group border border-brand-greenDark will-change-transform"
        >
          <!-- MessageCircle Inline SVG -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-4 opacity-100 shrink-0"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          <span class="font-medium flex-1 text-center pr-9 tracking-wide">Agendar Atendimento</span>
        </a>

        <a 
          href="/" 
          class="flex items-center p-4 bg-white/80 backdrop-blur-lg border border-white/50 text-brand-greenDark rounded-2xl transition-all duration-300 hover:bg-white hover:border-brand-green/30 hover:shadow-soft hover:-translate-y-0.5 group shadow-[0_8px_32px_0_rgba(0,0,0,0.05)] will-change-transform"
        >
          <!-- Globe Inline SVG -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-4 text-brand-green opacity-90 shrink-0"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          <span class="font-medium flex-1 text-center pr-9 tracking-wide">Acessar meu Site</span>
        </a>

        <a 
          href="https://wa.me/5549991069172?text=Olá%20Isabel,%20vim%20pelo%20seu%20site%20e%20gostaria%20de%20saber%20mais%20sobre%20a%20terapia%20online." 
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center p-4 bg-white/80 backdrop-blur-lg border border-white/50 text-brand-greenDark rounded-2xl transition-all duration-300 hover:bg-white hover:border-brand-green/30 hover:shadow-soft hover:-translate-y-0.5 group shadow-[0_8px_32px_0_rgba(0,0,0,0.05)] will-change-transform"
        >
          <!-- MonitorSmartphone Inline SVG -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-4 text-brand-green opacity-90 shrink-0"><path d="M18 8V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2"/><path d="M10 15v4a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-4"/><rect width="10" height="14" x="12" y="6" rx="2"/></svg>
          <span class="font-medium flex-1 text-center pr-9 tracking-wide">Terapia Online</span>
        </a>

        <a 
          href="https://wa.me/5549991069172?text=Olá%20Isabel,%20vim%20pelo%20seu%20site%20e%20gostaria%20de%20saber%20mais%20sobre%20a%20terapia%20presencial." 
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center p-4 bg-white/80 backdrop-blur-lg border border-white/50 text-brand-greenDark rounded-2xl transition-all duration-300 hover:bg-white hover:border-brand-green/30 hover:shadow-soft hover:-translate-y-0.5 group shadow-[0_8px_32px_0_rgba(0,0,0,0.05)] will-change-transform"
        >
          <!-- MapPin Inline SVG -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-4 text-brand-green opacity-90 shrink-0"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="font-medium flex-1 text-center pr-9 tracking-wide">Terapia em Água Doce</span>
        </a>

        <a 
          href="https://www.instagram.com/psi.isabelgrando/" 
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center p-4 bg-white/80 backdrop-blur-lg border border-white/50 text-brand-greenDark rounded-2xl transition-all duration-300 hover:bg-white hover:border-brand-green/30 hover:shadow-soft hover:-translate-y-0.5 group shadow-[0_8px_32px_0_rgba(0,0,0,0.05)] will-change-transform"
        >
          <!-- Instagram Inline SVG -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-4 text-brand-green opacity-90 shrink-0"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
