---
import Layout from '../layouts/Layout.astro';
import { Instagram, MapPin, Globe, MessageCircle, MonitorSmartphone, Brain, Leaf, Heart, Puzzle, Sparkles } from 'lucide-astro';

const seoSchema = `
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "mainEntity": {
      "@type": "Person",
      "name": "Isabel Grando",
      "jobTitle": "Psicóloga Clínica",
      "url": "https://isabelgrando.com.br/links"
    }
  }
`;
---

<Layout 
  title="Links | Isabel Grando - Psicóloga" 
  description="Acesse meus principais links, agende sua consulta ou conheça mais sobre meu trabalho."
  schema={seoSchema}
>
  <main class="min-h-screen bg-brand-light relative py-12 px-4 sm:px-6 flex flex-col items-center justify-center overflow-hidden">
    <!-- Fundo Animado Orgânico -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
      <div class="absolute top-[-10%] left-[-10%] w-[60vw] h-[60vw] bg-brand-beige/80 rounded-full mix-blend-multiply filter blur-[100px] opacity-70 animate-blob"></div>
      <div class="absolute top-[20%] right-[-10%] w-[50vw] h-[50vw] bg-brand-green/30 rounded-full mix-blend-multiply filter blur-[120px] opacity-70 animate-blob animation-delay-2000"></div>
      <div class="absolute bottom-[-20%] left-[20%] w-[70vw] h-[70vw] bg-brand-beige/60 rounded-full mix-blend-multiply filter blur-[100px] opacity-70 animate-blob animation-delay-4000"></div>
    </div>

    <!-- Partículas Discretas (Psicologia) -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
      <!-- Brains -->
      <Brain class="absolute top-[15%] left-[8%] sm:left-[15%] w-8 h-8 text-brand-green opacity-20 animate-float" />
      <Brain class="absolute bottom-[40%] right-[8%] sm:right-[15%] w-6 h-6 text-brand-green opacity-[0.15] animate-float-delayed" style="animation-delay: -7s;" />
      
      <!-- Leaves -->
      <Leaf class="absolute top-[40%] right-[5%] sm:right-[12%] w-6 h-6 text-brand-green opacity-20 animate-float-delayed" />
      <Leaf class="absolute bottom-[10%] left-[12%] sm:left-[22%] w-5 h-5 text-brand-green opacity-30 animate-float" style="animation-delay: -4s;" />
      <Leaf class="absolute top-[5%] left-[30%] sm:left-[40%] w-7 h-7 text-brand-green opacity-10 animate-float-delayed" style="animation-delay: -9s;" />

      <!-- Hearts -->
      <Heart class="absolute bottom-[25%] left-[10%] sm:left-[20%] w-7 h-7 text-brand-green opacity-20 animate-float" style="animation-delay: -2s;" />
      <Heart class="absolute top-[25%] right-[25%] sm:right-[35%] w-5 h-5 text-brand-green opacity-25 animate-float-delayed" style="animation-delay: -8s;" />
      <Heart class="absolute bottom-[60%] left-[5%] sm:left-[8%] w-8 h-8 text-brand-green opacity-10 animate-float" style="animation-delay: -1s;" />

      <!-- Puzzles -->
      <Puzzle class="absolute top-[10%] right-[15%] sm:right-[25%] w-6 h-6 text-brand-green opacity-20 animate-float-delayed" style="animation-delay: -5s;" />
      <Puzzle class="absolute bottom-[20%] right-[10%] sm:right-[20%] w-9 h-9 text-brand-green opacity-10 animate-float" style="animation-delay: -11s;" />

      <!-- Sparkles -->
      <Sparkles class="absolute bottom-[10%] right-[15%] sm:right-[20%] w-8 h-8 text-brand-green opacity-20 animate-float" style="animation-delay: -3s;" />
      <Sparkles class="absolute top-[50%] left-[5%] sm:left-[10%] w-5 h-5 text-brand-green opacity-[0.15] animate-float-delayed" style="animation-delay: -6s;" />
      <Sparkles class="absolute top-[5%] right-[40%] sm:right-[50%] w-4 h-4 text-brand-green opacity-30 animate-float" style="animation-delay: -10s;" />
    </div>

    <div class="w-full max-w-md mx-auto flex flex-col items-center relative z-10">
      
      <!-- Perfil -->
      <div class="mb-5 relative animate-fade-in">
        <div class="w-28 h-28 rounded-full overflow-hidden shadow-xl border-4 border-white mx-auto relative z-10">
          <img 
            src="/profissional/isabel1.jpeg" 
            alt="Isabel Grando" 
            class="w-full h-full object-cover object-top opacity-0 transition-opacity duration-500"
            onload="this.classList.remove('opacity-0')"
          />
        </div>
        <!-- Brilho ao fundo da foto -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-28 h-28 bg-brand-green/20 rounded-full blur-xl -z-10"></div>
      </div>

      <div class="text-center mb-10 animate-fade-in delay-1">
        <h1 class="text-2xl font-serif text-brand-greenDark font-medium mb-1 tracking-wide">Isabel Grando</h1>
        <p class="text-brand-textMuted text-xs font-medium tracking-widest uppercase">Psicóloga Clínica · CRP 12/22453</p>
      </div>

      <!-- Links -->
      <div class="w-full space-y-4 animate-fade-in delay-2">
        <a 
          href="https://wa.me/5549991069172?text=Olá,%20gostaria%20de%20agendar%20uma%20consulta." 
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center p-4 bg-brand-greenDark text-white rounded-2xl transition-all duration-300 hover:bg-brand-green hover:-translate-y-1 shadow-lg hover:shadow-xl group border border-brand-greenDark"
        >
          <MessageCircle class="w-5 h-5 mr-4 opacity-100" />
          <span class="font-medium flex-1 text-center pr-9 tracking-wide">Agendar Atendimento</span>
        </a>

        <a 
          href="/" 
          class="flex items-center p-4 bg-white/80 backdrop-blur-lg border border-white/50 text-brand-greenDark rounded-2xl transition-all duration-300 hover:bg-white hover:border-brand-green/30 hover:shadow-soft hover:-translate-y-0.5 group shadow-[0_8px_32px_0_rgba(0,0,0,0.05)]"
        >
          <Globe class="w-5 h-5 mr-4 text-brand-green opacity-90" />
          <span class="font-medium flex-1 text-center pr-9 tracking-wide">Acessar meu Site</span>
        </a>

        <a 
          href="https://wa.me/5549991069172?text=Olá,%20gostaria%20de%20saber%20mais%20sobre%20a%20terapia%20ONLINE." 
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center p-4 bg-white/80 backdrop-blur-lg border border-white/50 text-brand-greenDark rounded-2xl transition-all duration-300 hover:bg-white hover:border-brand-green/30 hover:shadow-soft hover:-translate-y-0.5 group shadow-[0_8px_32px_0_rgba(0,0,0,0.05)]"
        >
          <MonitorSmartphone class="w-5 h-5 mr-4 text-brand-green opacity-90" />
          <span class="font-medium flex-1 text-center pr-9 tracking-wide">Terapia Online</span>
        </a>

        <a 
          href="https://wa.me/5549991069172?text=Olá,%20gostaria%20de%20saber%20mais%20sobre%20a%20terapia%20PRESENCIAL." 
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center p-4 bg-white/80 backdrop-blur-lg border border-white/50 text-brand-greenDark rounded-2xl transition-all duration-300 hover:bg-white hover:border-brand-green/30 hover:shadow-soft hover:-translate-y-0.5 group shadow-[0_8px_32px_0_rgba(0,0,0,0.05)]"
        >
          <MapPin class="w-5 h-5 mr-4 text-brand-green opacity-90" />
          <span class="font-medium flex-1 text-center pr-9 tracking-wide">Terapia em Água Doce</span>
        </a>

        <a 
          href="https://www.instagram.com/psi.isabelgrando/" 
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center p-4 bg-white/80 backdrop-blur-lg border border-white/50 text-brand-greenDark rounded-2xl transition-all duration-300 hover:bg-white hover:border-brand-green/30 hover:shadow-soft hover:-translate-y-0.5 group shadow-[0_8px_32px_0_rgba(0,0,0,0.05)]"
        >
          <Instagram class="w-5 h-5 mr-4 text-brand-green opacity-90" />
          <span class="font-medium flex-1 text-center pr-9 tracking-wide">Me acompanhe no Instagram</span>
        </a>
      </div>

      <!-- Footer SEO / Branding -->
      <div class="mt-12 mb-8 text-center text-sm text-brand-greenDark">
        <p>Desenvolvido com excelência por <a href="https://www.sitesalphacode.com.br/solucoes/psicologos" target="_blank" rel="noopener" title="Criação de Sites para Psicólogos" class="hover:text-brand-green transition-colors font-medium underline underline-offset-2">Sites Alpha Code</a></p>
      </div>

    </div>
  </main>
</Layout>

<style>
  @keyframes blob {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    33% {
      transform: translate3d(30px, -50px, 0) scale(1.1);
    }
    66% {
      transform: translate3d(-20px, 20px, 0) scale(0.9);
    }
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
  }
  .animate-blob {
    animation: blob 12s infinite alternate ease-in-out;
    will-change: transform;
    backface-visibility: hidden;
  }
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  .animation-delay-4000 {
    animation-delay: 4s;
  }
  @keyframes float {
    0% { transform: translate3d(0, 0, 0) rotate(0deg); }
    50% { transform: translate3d(0, -15px, 0) rotate(5deg); }
    100% { transform: translate3d(0, 0, 0) rotate(0deg); }
  }
  .animate-float {
    animation: float 8s ease-in-out infinite;
    will-change: transform;
  }
  .animate-float-delayed {
    animation: float 10s ease-in-out infinite alternate;
    will-change: transform;
  }

  /* GPU-Accelerated CSS Reveal Animations (0ms JS delay) */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }
  .animate-fade-in {
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
    will-change: transform, opacity;
  }
  .delay-1 {
    animation-delay: 100ms;
  }
  .delay-2 {
    animation-delay: 200ms;
  }
</style>
