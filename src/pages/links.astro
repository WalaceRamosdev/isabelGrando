---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profileImg from '../../public/profissional/isabel1.jpeg';

const seoSchema = `
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "mainEntity": {
      "@type": "Person",
      "name": "Isabel Grando",
      "jobTitle": "Psicóloga Clínica",
      "url": "https://isabelgrando.com.br/links"
    }
  }
`;
---

<Layout 
  title="Links | Isabel Grando - Psicóloga" 
  description="Acesse meus principais links, agende seu atendimento ou conheça mais sobre meu trabalho."
  schema={seoSchema}
>
  <main class="min-h-screen relative py-12 px-4 sm:px-6 flex flex-col items-center justify-center overflow-hidden" style="background: radial-gradient(circle at 10% -10%, rgba(243, 233, 223, 0.8) 0%, transparent 50%), radial-gradient(circle at 90% 20%, rgba(193, 140, 126, 0.3) 0%, transparent 50%), radial-gradient(circle at 30% 120%, rgba(243, 233, 223, 0.6) 0%, transparent 50%), #FAF9F6;">
    
    <!-- Partículas Discretas Estáticas Inline para Desempenho (Psicologia) -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
      <!-- Brain 1 -->
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute top-[15%] left-[8%] sm:left-[15%] w-8 h-8 text-brand-green opacity-20"><path d="M12 18V5"/><path d="M15 13a4.17 4.17 0 0 1-3-4 4.17 4.17 0 0 1-3 4"/><path d="M17.598 6.5A3 3 0 1 0 12 5a3 3 0 1 0-5.598 1.5"/><path d="M17.997 5.125a4 4 0 0 1 2.526 5.77"/><path d="M18 18a4 4 0 0 0 2-7.464"/><path d="M19.967 17.483A4 4 0 1 1 12 18a4 4 0 1 1-7.967-.517"/><path d="M6 18a4 4 0 0 1-2-7.464"/><path d="M6.003 5.125a4 4 0 0 0-2.526 5.77"/></svg>
